ODDS_API_KEY=your-the-odds-api-key-here

# Local dev default. For a deployed backend, set this to your Neon (or other
# Postgres) connection string instead -- a bare "postgresql://..." works,
# it's normalized to use the psycopg3 driver automatically (see app/db.py).
DATABASE_URL=sqlite:///./football.db

# Comma-separated list of frontend origins allowed to call this API.
# Add your deployed frontend's URL (e.g. https://footballpredictor.vercel.app)
# alongside the local dev defaults once you have one.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
