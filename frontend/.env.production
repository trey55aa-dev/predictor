# Used automatically by `vite build` (production mode). Point this at your
# deployed Render backend URL once you have one -- see README's deployment
# section. Vercel/Netlify/Cloudflare Pages will also let you set
# VITE_API_BASE_URL directly in their dashboard, which overrides this file;
# either approach works.
VITE_API_BASE_URL=https://your-backend.onrender.com
